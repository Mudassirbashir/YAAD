{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/server.cjs,data/admin_data.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
